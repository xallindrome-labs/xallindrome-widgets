{
  "name": "@xallindrome-labs/pricing-domain",
  "version": "0.1.0",
  "description": "Dependency-free pricing model: base package + per-unit overage + monthly add-ons.",
  "keywords": [
    "pricing",
    "quote",
    "calculator",
    "packages",
    "add-ons",
    "typescript"
  ],
  "license": "MIT",
  "author": "Andrew Wilson (https://xallindrome.co)",
  "homepage": "https://github.com/xallindrome-labs/xallindrome-widgets/tree/main/libs/pricing-domain#readme",
  "bugs": "https://github.com/xallindrome-labs/xallindrome-widgets/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xallindrome-labs/xallindrome-widgets.git",
    "directory": "libs/pricing-domain"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/index.js",
    "dist/index.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
